{
  "name": "shashinmori-api",
  "version": "1.0.0",
  "description": "ShashinMori backend SDK-ready API and worker service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:workers": "tsx watch src/workers.ts",
    "start": "node dist/index.js",
    "start:workers": "node dist/workers.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/middie": "^9.0.3",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@tus/file-store": "^2.0.0",
    "@tus/server": "^2.3.0",
    "@upstash/redis": "^1.35.3",
    "bullmq": "^5.12.10",
    "check-disk-space": "^3.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "file-type": "^19.6.0",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
